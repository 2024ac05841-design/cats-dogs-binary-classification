FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (removed git - not needed in container)
RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# Copy training-specific requirements (excludes inference and dev dependencies)
COPY requirements-training.txt .

# Install Python dependencies with BuildKit cache mount
# Using CPU-only PyTorch reduces image size from 5.4GB to ~1.5GB
# --no-cache-dir saves space, remove .pyc files and __pycache__
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-training.txt && \
    find /usr/local/lib/python*/site-packages -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python*/site-packages -name "*.pyc" -delete 2>/dev/null || true

# Copy application code
COPY src ./src
COPY models ./models

# Create necessary directories
RUN mkdir -p logs data

# Set environment variables for MLFlow and training
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MLFLOW_TRACKING_URI=http://mlflow:5000
ENV EXPERIMENT_NAME=cats-dogs-k8s

# No explicit CMD or ENTRYPOINT - training script will be called via command override
# This allows flexibility for different training commands from Kubernetes
