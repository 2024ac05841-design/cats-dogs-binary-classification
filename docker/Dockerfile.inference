FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy inference requirements with CPU-optimized PyTorch
COPY requirements.txt .

# Install dependencies using BuildKit pip cache
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code and baseline fallback models
COPY src ./src
COPY models ./models

# Create necessary directories for models cache and logs
RUN mkdir -p logs data /app-models

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV MLFLOW_TRACKING_URI=http://mlflow:5000
ENV REGISTERED_MODEL_NAME=cats-dogs-best-model
ENV MODEL_STAGE=Production
ENV EXPERIMENT_NAME=cats-dogs-k8s
ENV MODEL_PATH=/app-models/model.pkl

# Expose inference port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI application for inference
CMD ["python", "-m", "uvicorn", "src.inference.app:app", "--host", "0.0.0.0", "--port", "8000"]
